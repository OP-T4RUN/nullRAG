APP_ENV=development
HOST=0.0.0.0
PORT=8000

# LLM Configuration: Gemini or OpenAI/OpenCode
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.5-flash
# For OpenAI / OpenCode:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Langfuse Observability (Optional for local dev, required for competition scoring)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval parameters
CHUNK_SIZE=400
CHUNK_OVERLAP=50
CANDIDATE_DEPTH=25
FINAL_CONTEXT_K=10
